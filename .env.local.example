# Copy to .env.local and fill in your values

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (required for password reset emails — use your live Vercel URL in production)
NEXT_PUBLIC_APP_URL=https://staff-attendance-system-tau.vercel.app

# Database migrations only (optional — from Supabase Dashboard → Database → password)
# SUPABASE_DB_PASSWORD=your-database-password

# Desktop app port (optional)
# ATTENDPRO_PORT=3847

# Didit face verification (optional — enables PIN + face clock-in at /kiosk)
# Create a Biometric Authentication workflow with Liveness + Face Match in Didit console
# DIDIT_API_KEY=your_didit_api_key
# DIDIT_WORKFLOW_ID=your_biometric_authentication_workflow_uuid

# AWS Rekognition (required for production face match — see BIOMETRIC_SETUP.md)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_REKOGNITION_SIMILARITY_THRESHOLD=90
AWS_FACE_LIVENESS_CONFIDENCE_THRESHOLD=80

# Optional: AWS Face Liveness in browser (see docs/aws-face-liveness-cognito.md)
# NEXT_PUBLIC_AWS_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NEXT_PUBLIC_AWS_REGION=us-east-1
